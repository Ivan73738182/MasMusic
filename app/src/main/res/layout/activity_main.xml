<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F0F1A">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MasMusic"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:padding="20dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/infoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ищу музыку..."
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:paddingHorizontal="20dp"
        android:paddingBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/songsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="8dp"
        android:clipToPadding="false" />

    <LinearLayout
        android:id="@+id/miniPlayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1E2E"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/miniProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="100"
            android:progressTint="#6A1B9A"
            android:progressBackgroundTint="#333344" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/currentSong"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Не играет"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <Button
                android:id="@+id/prevBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏮"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#333344"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/playPauseBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏸"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6A1B9A"
                android:minWidth="0dp"
                android:paddingHorizontal="18dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/nextBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏭"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#333344"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
